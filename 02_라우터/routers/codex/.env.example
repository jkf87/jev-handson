# mock = 고정 실습 응답, live = 실제 Jev API 호출
JEV_MODE=mock
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# dry-run = 실행 계획만 반환, live = 실제 Codex 작업 시작(codex exec, 읽기 전용)
CODEX_MODE=dry-run
# 비우면 Codex 기본 모델(~/.codex/config.toml). 정하려면 codex의 모델 이름을 적는다
CODEX_MODEL=
# 3강 로컬 호환 서버를 쓸 때만
# TYPESAFE_BASE_URL=http://127.0.0.1:8000
PORT=8427
# 교육용 초기값. 실제 데이터로 조정하세요.
ROUTE_CONFIDENCE=0.8
